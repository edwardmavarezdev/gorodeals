---
// Plantilla de bloque de precio. Se clona desde el cliente.
---

<template data-template="price-tag">
  <span class="price-tag">
    <span class="price-tag__values">
      <span class="price-current" data-price-current></span>
      <span class="price-regular" data-price-regular></span>
    </span>
    <span class="discount" data-price-discount></span>
  </span>
</template>
