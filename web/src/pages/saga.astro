---
import Base from '../layouts/Base.astro';
import ErrorState from '../components/ErrorState.astro';

---

<Base title="Ruta de saga - GoRoDeals">
  <h1 class="page-title" data-franchise-title>Ruta de saga</h1>
  <p class="page-subtitle" data-franchise-description></p>

  <div id="franchise-state" data-franchise-state></div>

  <ol class="route-list" data-route-list></ol>

  <ErrorState />
</Base>

<script>
  import { getFranchiseRoute, describeError } from '../lib/api';
  import { formatDate, renderError, setCover, showLoading } from '../lib/render';

  const slug = new URLSearchParams(window.location.search).get('slug') ?? '';
  const state = document.querySelector<HTMLElement>('[data-franchise-state]');
  const list = document.querySelector<HTMLElement>('[data-route-list]');
  const title = document.querySelector<HTMLElement>('[data-franchise-title]');
  const description = document.querySelector<HTMLElement>('[data-franchise-description]');

  async function load(): Promise<void> {
    if (!state || !list) return;

    if (!slug) {
      renderError(state, 'Falta el parametro "slug" en la URL.');
      return;
    }

    showLoading(state, 'Cargando ruta de la saga...');

    try {
      const data = await getFranchiseRoute(slug);
      state.innerHTML = '';

      if (title) title.textContent = data.name;
      if (description) description.textContent = data.description ?? '';
      document.title = `${data.name} - GoRoDeals`;

      list.innerHTML = '';

      if (data.route.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'state';
        empty.textContent = 'Esta saga todavia no tiene ruta registrada.';
        list.appendChild(empty);
        return;
      }

      for (const entry of data.route) {
        const item = document.createElement('li');
        item.className = 'route-item';

        const position = document.createElement('span');
        position.className = 'route-item__position';
        position.textContent = String(entry.position);
        item.appendChild(position);

        const cover = document.createElement('div');
        cover.className = 'route-item__cover';
        cover.setAttribute('role', 'img');
        setCover(cover, entry.game.coverUrl, entry.game.title, '--');
        item.appendChild(cover);

        const body = document.createElement('div');

        const titleNode = document.createElement('p');
        titleNode.className = 'route-item__title';
        const link = document.createElement('a');
        link.href = `/juego?slug=${encodeURIComponent(entry.game.slug)}`;
        link.textContent = entry.game.title;
        titleNode.appendChild(link);
        body.appendChild(titleNode);

        if (entry.note) {
          const note = document.createElement('p');
          note.className = 'route-item__note';
          note.textContent = entry.note;
          body.appendChild(note);
        }

        const meta = document.createElement('span');
        meta.className = 'route-item__meta';
        meta.textContent = [
          entry.game.releaseDate ? formatDate(entry.game.releaseDate) : null,
          entry.game.qualityScore !== null ? `Calidad ${entry.game.qualityScore}` : null,
        ]
          .filter(Boolean)
          .join(' - ');
        body.appendChild(meta);

        item.appendChild(body);
        list.appendChild(item);
      }
    } catch (error) {
      list.innerHTML = '';
      renderError(state, describeError(error));
    }
  }

  void load();
</script>
