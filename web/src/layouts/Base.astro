---
import '../styles/global.css';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const { title, description = 'GoRoDeals: seguimiento de precios de videojuegos y rutas de sagas.', current } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <Header current={current} />

    <main class="page">
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        GoRoDeals. Seguimiento de precios de videojuegos y guias para empezar las sagas.
      </div>
    </footer>
  </body>
</html>
