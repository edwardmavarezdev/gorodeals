{
  "$comment": [
    "Contrato de la API: los 40 endpoints publicos.",
    "Se usa para capturar los fixtures golden (tools/capture-fixtures.mjs) y",
    "para comprobar en cada test que Fastify responde lo mismo.",
    "auth: true significa que la ruta exige access token.",
    "Los marcadores {gameSlug}, {gameId}, {franchiseSlug}, {publicationSlug},",
    "{igdbId} y {storeProductId} se resuelven en tiempo de ejecucion con datos",
    "reales de la base de desarrollo."
  ],
  "endpoints": [
    { "method": "GET", "path": "/health" },
    { "method": "GET", "path": "/catalog?page=1&limit=5" },
    { "method": "GET", "path": "/catalog?sort=discount&store=steam&limit=5" },
    { "method": "GET", "path": "/catalog?sort=quality&q=a&limit=5" },
    { "method": "GET", "path": "/games/{gameSlug}" },
    { "method": "GET", "path": "/games/{gameSlug}?months=6" },
    { "method": "GET", "path": "/games/{gameId}/price-history" },
    { "method": "GET", "path": "/games/{gameId}/price-history?months=3" },
    { "method": "GET", "path": "/franchises" },
    { "method": "GET", "path": "/franchises/{franchiseSlug}/route" },
    { "method": "GET", "path": "/deals/hottest?limit=5" },
    { "method": "GET", "path": "/deals/hottest" },
    { "method": "GET", "path": "/publications" },
    { "method": "GET", "path": "/publications?limit=2&category=ruta" },
    { "method": "GET", "path": "/publications/categories" },
    { "method": "GET", "path": "/publications/{publicationSlug}" },
    { "method": "GET", "path": "/price-sync/status" },
    { "method": "POST", "path": "/price-sync/run", "admin": true },
    { "method": "GET", "path": "/price-sync/history/{storeProductId}" },
    { "method": "POST", "path": "/admin/sync/random?count=1&platforms=steam", "admin": true },
    { "method": "POST", "path": "/auth/register", "body": { "email": "no-es-un-email", "password": "corta", "displayName": "X" } },
    { "method": "POST", "path": "/auth/login", "body": { "email": "nadie@example.com", "password": "Contrasena1!" } },
    { "method": "POST", "path": "/auth/refresh", "body": { "refreshToken": "token-que-no-existe" } },
    { "method": "GET", "path": "/auth/me", "auth": true },
    { "method": "PATCH", "path": "/auth/me", "auth": true, "body": { "displayName": "Nombre de prueba" } },
    { "method": "GET", "path": "/auth/google" },
    { "method": "GET", "path": "/auth/steam" },
    { "method": "POST", "path": "/auth/social/exchange", "body": { "code": "codigo-que-no-existe" } },
    { "method": "GET", "path": "/igdb/search?q=zelda&limit=3" },
    { "method": "GET", "path": "/igdb/games/search?q=zelda&limit=3" },
    { "method": "GET", "path": "/igdb/games/{igdbId}" },
    { "method": "POST", "path": "/igdb/sync", "admin": true, "body": { "limit": 1 } },
    { "method": "GET", "path": "/steam/app/{appId}" },
    { "method": "POST", "path": "/steam/batch", "admin": true, "body": { "appIds": [1091500] } },
    { "method": "POST", "path": "/steam/sync", "admin": true, "body": { "gameId": "00000000-0000-0000-0000-000000000000", "appIds": [1091500] } },
    { "method": "GET", "path": "/steam/product/{appId}" },
    { "method": "GET", "path": "/wishlist", "auth": true },
    { "method": "POST", "path": "/wishlist", "auth": true, "body": { "gameId": "00000000-0000-0000-0000-000000000000" } },
    { "method": "DELETE", "path": "/wishlist/00000000-0000-0000-0000-000000000000", "auth": true },
    { "method": "DELETE", "path": "/wishlist/slug/no-existe", "auth": true },
    { "method": "POST", "path": "/wishlist/sync/gog", "auth": true }
  ]
}
