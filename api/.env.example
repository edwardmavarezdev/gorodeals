# Servidor
PORT=3000
NODE_ENV=development

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=gorodeals
DB_PASSWORD=gorodeals
DB_NAME=gorodeals
DB_SSL=false
# Pool de conexiones de PostgreSQL (el servidor admite 100).
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000

# IGDB / Twitch Developer
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
IGDB_ADMIN_SECRET=

# Opcionales: solo para pruebas con un stub local
# IGDB_API_URL=https://api.igdb.com/v4/games
# IGDB_TOKEN_URL=https://id.twitch.tv/oauth2/token
# Timeout de las peticiones a IGDB (token, API y renovacion), en ms.
IGDB_TIMEOUT_MS=10000

# Steam (store API y OpenID)
STEAM_API_KEY=
STEAM_REALM_URI=http://localhost:3000
# Region de referencia del catalogo: `us` publica USD, `es` publica EUR.
STEAM_COUNTRY_CODE=us
STEAM_LANGUAGE=es
STEAM_API_BASE_URL=https://store.steampowered.com/api
STEAM_TIMEOUT_MS=12000
STEAM_MAX_RETRIES=3
STEAM_CACHE_TTL_MS=900000
STEAM_BATCH_SIZE=50
STEAM_CONCURRENCY=4
STEAM_INTER_BATCH_DELAY_MS=250
# Tope de entradas de la cache en memoria de la API de Steam (TTL + LRU).
STEAM_CACHE_MAX_ENTRIES=10000
# Secreto del endpoint POST /steam/sync (header x-admin-secret).
# Si se omite se reutiliza IGDB_ADMIN_SECRET; sin ninguno, el endpoint queda cerrado.
STEAM_ADMIN_SECRET=

# Price Sync (Fase 3.3)
# Expresion cron del sync diario de precios (timezone UTC).
PRICE_SYNC_CRON=0 6 * * *
# Permite desactivar el cron (por ejemplo en desarrollo).
PRICE_SYNC_ENABLED=true
# Numero de store_products por lote al recorrer el catalogo.
PRICE_SYNC_BATCH_SIZE=200
# Tiendas a sincronizar, separadas por coma (steam,gog,nintendo).
PRICE_SYNC_STORE_NAMES=steam
# Secreto del endpoint manual POST /price-sync/run (header x-admin-secret).
# Si se omite se reutiliza IGDB_ADMIN_SECRET.
PRICE_SYNC_ADMIN_SECRET=
# Paginas de catalogo de IGDB (limit/offset) a sincronizar antes de auditar precios.
PRICE_SYNC_CATALOG_PAGES=0
# Segundos tras los cuales un lock de sync se considera obsoleto.
PRICE_SYNC_LOCK_TIMEOUT_SECONDS=3600
# Pausa entre peticiones consecutivas a la API de la tienda (ms).
PRICE_SYNC_REQUEST_DELAY_MS=50
# Umbral (0-1) de fallos TECNICOS por lote que aborta el ciclo de la tienda.
# Un fallo tecnico (Steam caido, 403 por abuso, sin red) no marca el catalogo
# como no disponible; solo un "sin datos" real lo hace.
PRICE_SYNC_MAX_FAILURE_RATE=0.5

# CORS: origenes permitidos, separados por coma. Vacio desactiva el navegador.
# 4322 se incluye porque Astro pasa al siguiente puerto libre si 4321 esta ocupado.
CORS_ORIGIN=http://localhost:4321,http://localhost:4322

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=http://localhost:3000/auth/google/callback

# Sincronizacion de juegos de prueba (endpoint y script)
# Secreto del endpoint POST /admin/sync/random (cabecera x-admin-secret).
# Si se omite se reutiliza IGDB_ADMIN_SECRET; sin ninguno, el endpoint queda
# cerrado (403) y el script de CLI sigue funcionando.
ADMIN_SYNC_SECRET=
# Numero de juegos por tienda que se sincronizan por defecto.
SYNC_RANDOM_COUNT=10
# Tiendas incluidas por defecto, separadas por coma (steam,nintendo).
SYNC_RANDOM_PLATFORMS=steam,nintendo
